{
  "name": "github-account-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "admin:reset": "node scripts/reset-admin.mjs",
    "admin:unlock": "node scripts/unlock-admin.mjs",
    "browser:install": "node scripts/install-oauth-browser.mjs",
    "backup": "node scripts/backup-data.mjs",
    "restore": "node scripts/restore-data.mjs",
    "test": "node --test tests/*.test.js",
    "harden:data": "node scripts/harden-data.mjs",
    "check:data": "node scripts/harden-data.mjs --check",
    "lint": "eslint .",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:browser": "node --test --test-concurrency=2 tests/*-browser.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.3.1",
    "playwright-core": "^1.64.1",
    "proxy-chain": "^3.0.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.4",
    "globals": "^17.13.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.0"
  }
}
