# nginx 反向代理示例：后台只对白名单 IP 开放，对外 API 保持公开。
#
# 替换 www.example.com / api.example.com 与 allow 列表后放到
# /etc/nginx/conf.d/account-desk.conf，然后 nginx -t && systemctl reload nginx。
# 项目进程需要设置：
#   ACCOUNT_DESK_ADMIN_ORIGIN=https://www.example.com
#   ACCOUNT_DESK_API_ORIGIN=https://www.example.com   # API 用独立域名时改成 api 域名
#   ACCOUNT_DESK_TRUST_PROXY=1                        # 开启后按真实客户端 IP 区分登录锁定来源
#
# 白名单只拦在代理层。进程仍只监听 127.0.0.1，公网无法绕过 nginx 直连 4318/4319。

# ---------------------------------------------------------------------------
# 后台 + API 同域名：/api/v1/* 走 4319，其余走 4318，整站要求白名单
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name www.example.com;

    ssl_certificate     /etc/letsencrypt/live/www.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.example.com/privkey.pem;

    client_max_body_size 2m;

    # --- 访问白名单：先写 allow，最后一定跟一条 deny all -------------------
    # 顺序有意义，nginx 从上往下匹配，第一条命中即生效。
    allow 203.0.113.10;        # 家里固定 IP
    allow 198.51.100.0/24;     # 公司出口网段
    allow 2001:db8::/32;       # IPv6 网段
    deny  all;                 # 其余一律 403

    # 本机自用（例如 SSH 隧道）不受影响，走的不是这个入口。

    location /api/v1/ {
        proxy_pass http://127.0.0.1:4319;
        proxy_http_version 1.1;

        # Host 必须原样透传：应用用 Host / Origin 做来源校验，
        # 改写成 127.0.0.1 会让后台判定为跨站来源并 403。
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # 用 $remote_addr 覆盖而不是追加：客户端自己带来的 X-Forwarded-For
        # 不可信，追加会让它能伪造来源、绕开按来源的登录锁定。
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:4318;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 账号检测、PAT 轮换这类长任务通过轮询接口汇报进度，
        # 单次请求不会超过 30 秒，留一点余量即可。
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}

# 80 端口只做跳转，不放行内容，避免出现一个绕过白名单的明文入口。
server {
    listen 80;
    server_name www.example.com;
    return 301 https://$host$request_uri;
}

# ---------------------------------------------------------------------------
# 后台与 API 分域名时可选用：API 域名不需要白名单（靠 API Key 鉴权），
# 后台域名整站保留上面的 allow/deny。
